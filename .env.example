# =======================================================
# EPUB TRANSLATOR CONFIGURATION (.env.example)
# =======================================================

# 1. API Keys Gemini (Pilih salah satu atau isi keduanya)
# Single key:
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# Multiple keys (dipisahkan koma atau spasi untuk rotasi dan fallback otomatis jika kuota limit):
# GEMINI_API_KEYS="key_alpha,key_beta,key_gamma"

# 2. Model Gemini (default: gemini-2.5-flash)
# Opsi populer: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# 3. Parameter Batching & Permintaan
BATCH_SIZE=20
REQUEST_TIMEOUT=60.0

# 4. Strategi Rotasi Kunci (round_robin atau fallback_on_limit)
ROTATION_STRATEGY=round_robin
