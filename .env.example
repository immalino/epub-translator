# =======================================================
# EPUB TRANSLATOR CONFIGURATION (.env.example)
# =======================================================

# 1. Provider Translasi: gemini (default) atau ollama
TRANSLATION_PROVIDER=gemini

# 2. Direktori Folder Input dan Output
INPUT_DIR=input
OUTPUT_DIR=output

# 3. Parameter Inferensi / Batching
BATCH_SIZE=20
REQUEST_TIMEOUT=60.0

# 4. Google Gemini API
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
# GEMINI_API_KEYS="key_alpha,key_beta,key_gamma"
GEMINI_MODEL=gemini-2.5-flash
ROTATION_STRATEGY=round_robin

# =======================================================
# Konfigurasi Opsional: Model Lokal Ollama (jika TRANSLATION_PROVIDER=ollama)
# =======================================================
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=translategemma:4b


