# =======================================================
# EPUB TRANSLATOR CONFIGURATION (.env.example)
# =======================================================

# 1. Provider Translasi: ollama (default) atau gemini
TRANSLATION_PROVIDER=ollama

# 2. Konfigurasi Ollama Lokal
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=translategemma:4b

# 3. Direktori Folder Input dan Output
INPUT_DIR=input
OUTPUT_DIR=output

# 4. Parameter Inferensi / Batching
BATCH_SIZE=5
REQUEST_TIMEOUT=120.0

# =======================================================
# Konfigurasi Opsional: Google Gemini API (jika TRANSLATION_PROVIDER=gemini)
# =======================================================
# GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here
# GEMINI_API_KEYS="key_alpha,key_beta,key_gamma"
# GEMINI_MODEL=gemini-2.5-flash
# ROTATION_STRATEGY=round_robin

